# Optional. Without these, judge (L6) and embedding (L5) assertions are not
# evaluated and the live framework examples are skipped.

# LLM judge and OpenAI embeddings; also used by langchain-agent and llamaindex-agent
OPENAI_API_KEY=

# google-adk example (Gemini)
GOOGLE_API_KEY=

# Optional: path to an attest-engine binary (otherwise the SDK downloads the pinned release)
# ATTEST_ENGINE_PATH=
